# Copy this file to .env in the repository root and fill in the placeholders.
# .env is private and ignored by Git; never commit real credentials.
#
# The root .env is read by:
# - Docker Compose (compose.yaml), for the postgres and backend services;
# - the Spring Boot backend when run locally (./mvnw spring-boot:run from backend/),
#   which loads ../.env (springdotenv.directory in application.properties).
# The frontend does NOT read this file; see frontend/.env.example.
#
# Do not leave a variable empty (VAR=) to "unset" it: an empty value replaces the
# default. Remove or comment out the line instead. (THE_ONE_API_ACCESS_TOKEN is the exception:
# empty and undefined behave the same.)

# ==========================================
# Persistence switch (backend)
# ==========================================
# Optional. Default: false.
# Turns the database layer on (DataSource, Hibernate/JPA and Flyway). The leaderboard is the
# only feature that stores data. While false, the backend starts without PostgreSQL, the
# leaderboard answers HTTP 503 and every game still works; the DB_* variables below are then
# not used by the backend.
# When true, the backend needs a reachable PostgreSQL and a non-empty DB_PASSWORD, otherwise
# startup fails.
# Under Docker Compose, a start with true also needs the postgres service reachable (see the
# note in compose.yaml about depends_on).
WUNDERLORE_PERSISTENCE_ENABLED=false

# ==========================================
# Database (PostgreSQL)
# ==========================================
# These feed the postgres container (compose.yaml) and, when persistence is enabled, the
# backend connection.

# Optional. Default: wunderlore.
# Database created in the Docker PostgreSQL container, and database name used by the backend
# under Docker Compose. Not read by the backend outside Compose: for a local run the name
# comes from DB_URL.
DB_NAME=wunderlore

# Required by `docker compose up` (it aborts if unset), for both the postgres and backend
# services. For a local backend run the default is postgres, but only when persistence is
# enabled.
# The Docker PostgreSQL volume is initialized with this user and password on its first start;
# changing them later does not change an existing volume.
DB_USERNAME=postgres

# Required by `docker compose up` and whenever persistence is enabled. No default.
# Placeholder: replace it with a password of your choice.
DB_PASSWORD=change_me

# Optional. Default: 5433.
# Host port published for the PostgreSQL container (loopback only; the container port is 5432).
# 5433 avoids clashing with a PostgreSQL installed directly on the machine.
DB_PORT=5433

# Optional. Only read by the backend run locally (./mvnw spring-boot:run), and only when
# persistence is enabled. Docker Compose ignores this value for the backend container and
# points it at the postgres service by itself.
# Default when undefined: jdbc:postgresql://localhost:5432/wunderlore (PostgreSQL installed
# directly on the machine).
# - Docker PostgreSQL (host port DB_PORT, 5433 by default): keep the line below. If you change
#   DB_PORT, update the port here too, and the database name if you changed DB_NAME.
# - PostgreSQL on the machine (port 5432): set it to jdbc:postgresql://localhost:5432/wunderlore,
#   or remove/comment out the line to use the default above.
DB_URL=jdbc:postgresql://localhost:5433/wunderlore

# ==========================================
# Backend (Docker Compose)
# ==========================================
# Optional. Default: 8080.
# Host port published for the backend container (loopback only; the container always listens
# on 8080). A backend run locally with Maven listens on 8080 and ignores this variable.
BACKEND_PORT=8080

# ==========================================
# External API (The One API)
# ==========================================
# Optional for the backend to start, but needed for part of the app. Default: empty.
# Access token for the authenticated endpoints of The One API (/quote and /character).
# - Without it, the quote catalog and the "Who Said It?" game answer HTTP 503, and the
#   backend logs a warning at startup.
# - The book listing (/book) is public and works without a token. The Lore Challenge,
#   "Who Am I?", "Where in Middle-earth" and "Which Character" games use curated data and do
#   not depend on it.
# Get a token from your account: https://the-one-api.dev/documentation
# Placeholder: fill in manually.
THE_ONE_API_ACCESS_TOKEN=

# ==========================================
# Frontend (Docker Compose, not yet active)
# ==========================================
# The frontend service in compose.yaml is commented out, so this variable has no effect today.
# It becomes the host port published for the frontend container once that block is enabled
# (default 3000). `next dev` / `next start` choose their own port and ignore it.
# FRONTEND_PORT=3000
