# ==========================================
# Database (PostgreSQL)
# ==========================================
DB_NAME=wunderlore
DB_USERNAME=postgres
DB_PASSWORD=change_me
# Host port mapped to the PostgreSQL container (container port is 5432)
DB_PORT=5433

# ==========================================
# Backend (Spring Boot)
# ==========================================
# Used when running the backend locally (./mvnw spring-boot:run).
# Under Docker Compose this is overridden to point to the postgres service.
# Selects which PostgreSQL the local backend connects to:
# - Docker PostgreSQL (host port DB_PORT, 5433 by default): keep the line below.
#   If you change DB_PORT, update the port in this URL as well.
# - PostgreSQL installed directly on the machine (port 5432): point DB_URL to
#   jdbc:postgresql://localhost:5432/wunderlore, or remove/comment out the line
#   to use the fallback in application.properties. Do not leave it empty
#   (DB_URL=), because an empty value replaces the fallback.
DB_URL=jdbc:postgresql://localhost:5433/wunderlore
# Host port mapped to the backend container
BACKEND_PORT=8080

# ==========================================
# External API (The One API)
# ==========================================
# Access token for authenticated endpoints of The One API.
# The /book endpoint is publicly accessible and does not require authentication,
# so the book listing works without a token.
# The quote catalog and the "Who Said It?" game require a valid token
# (they call /quote and /character). Without it, these features respond
# with HTTP 503 Service Unavailable.
# Obtain an access token through your account:
# https://the-one-api.dev/documentation
# Keep the real token only in the root .env file, which is private and ignored
# by Git. Never commit it.
THE_ONE_API_ACCESS_TOKEN=

# ==========================================
# Frontend
# ==========================================
# Backend URL read by the Next.js server (not exposed to the browser).
# For local runs, set it in frontend/.env (see frontend/.env.example).
# FRONTEND_PORT=3000
# API_URL=http://localhost:8080
