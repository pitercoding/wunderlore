# Copy this file to frontend/.env (or frontend/.env.local) for local development.
# These files are private and ignored by Git. The root .env is not read by the frontend.

# Required. No default.
# Base URL of the Wunderlore backend, read only on the Next.js server (src/lib/api/client.ts).
# It is not prefixed with NEXT_PUBLIC_, so it is never exposed to the browser. A trailing
# slash is accepted. If it is missing, every backend call fails with "API_URL is not configured".
# 8080 is the backend's default port, both with Maven and with Docker Compose (BACKEND_PORT).
# If you change BACKEND_PORT in the root .env, update the port here.
# In production this is set in the hosting provider's settings, not in a file.
API_URL=http://localhost:8080
